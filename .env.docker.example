# Copy to .env.docker. Run Compose with --env-file .env.docker.
# Public hostname or IPv4; no scheme, port, or path.
# Public IPs need the Caddy configuration in docs/deploy-docker.md, section 2.1.
APP_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
GROWDU_IMAGE_TAG=local

DB_NAME=growdu
# Generate each password separately: openssl rand -hex 32
# DB_APP_PASSWORD must contain at least 64 hexadecimal characters.
MYSQL_ROOT_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_APP_PASSWORD=
JWT_ACCESS_SECRET=

DB_POOL_SIZE=10
INVOICE_AUTOMATION_ENABLED=true
PAYROLL_AUTOMATION_ENABLED=true
